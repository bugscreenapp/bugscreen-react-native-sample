{
  "expo": {
    "name": "BugScreen Travel",
    "slug": "bugscreen-react-native-sample",
    "scheme": "bugscreen-travel-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "app.bugscreen.example.travel.expo",
      "supportsTablet": true
    },
    "android": {
      "package": "app.bugscreen.example.travel.expo"
    },
    "plugins": [
      "expo-router",
      [
        "@bugscreen/react-native",
        {
          "photoLibraryUsageDescription": "BugScreen attaches the screenshot you just took to your bug report so we can see exactly what you saw."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
